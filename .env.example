# ConfirmaSUS Local Development Environment
# Copy to .env and adjust as needed

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=confirmasus
POSTGRES_PORT=5432

# Gateway
GATEWAY_PORT=8080

# Auth Service
AUTH_SERVICE_PORT=8081
AUTH_MANAGEMENT_PORT=8090
JWT_SECRET=supersecretkey1234567890123456
TECH_USERNAME=admin-tecnico
TECH_PASSWORD=senha-tecnica-segura

# Triagem Score Service
TRIAGEM_SCORE_SERVICE_PORT=8084
TRIAGEM_SCORE_MANAGEMENT_PORT=8093

# Matching/Alocacao Service
MATCHING_ALOCACAO_SERVICE_PORT=8083
MATCHING_ALOCACAO_MANAGEMENT_PORT=8092

# Agendamento/Confirmacao Service
AGENDAMENTO_CONFIRMACAO_SERVICE_PORT=8082
AGENDAMENTO_CONFIRMACAO_MANAGEMENT_PORT=8091

# Auditoria Service
AUDITORIA_SERVICE_PORT=8085
AUDITORIA_MANAGEMENT_PORT=8094

# LocalStack (SQS/SNS)
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Seed Adapter
SEED_ADAPTER_ENABLED=true
