<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.confirmasus</groupId>
  <artifactId>confirmasus-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>ConfirmaSUS — Parent</name>
  <description>
    Projeto Maven multi-modulo raiz do ConfirmaSUS (adjt-fase5-confirmasus).
    Modulos: gateway-service, auth-service, infra-cdk,
    agendamento-confirmacao-service (Epic 1), liberacao-repasse-service
    (Epic 2 -- Lista de Espera/Sugestao de Repasse FIFO, AD-6; a renomeacao
    para liberacao-repasse-service prevista na Architecture Spine continua
    pendente), auditoria-service (Epic 3). O antigo triagem-score-service
    (produto anterior, calculo de Score de Prioridade Clinica) foi
    decomissionado por restricao legal -- sem substituto, a fila de
    Repasse e ordenada exclusivamente por ordem de chegada.
    seed-adapter (CLI Java standalone, AD-13) nao entra neste reactor Spring
    Boot -- tem build/runtime proprio.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>

    <!-- AD-13 / Stack (ARCHITECTURE-SPINE.md): verificado 2026-09-06, reconfirmar antes do build real -->
    <spring-boot.version>4.1.1</spring-boot.version>
    <spring-cloud.version>2025.1.2</spring-cloud.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${maven.compiler.release}</release>
            <compilerArgs>
              <arg>-parameters</arg>
            </compilerArgs>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <modules>
    <module>gateway-service</module>
    <module>auth-service</module>
    <module>infra-cdk</module>
    <module>agendamento-confirmacao-service</module>
    <module>liberacao-repasse-service</module>
    <module>auditoria-service</module>
  </modules>

</project>
