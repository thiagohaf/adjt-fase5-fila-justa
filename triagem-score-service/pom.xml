<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.filajusta</groupId>
    <artifactId>fila-justa-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>triagem-score-service</artifactId>
  <packaging>jar</packaging>

  <name>triagem-score-service</name>
  <description>
    Primeiro servico de dominio do FilaJusta (Epic 2). Story 2.1 expoe
    POST /v1/triagens (FR-1, FR-3): valida CPF e sinais vitais (AD-11),
    resolve/cria o Paciente por CPF de forma idempotente, calcula um Score
    deterministico versionado (algoritmo v1) e grava um evento
    ScoreCalculado em tabela outbox. Story 3.0 acrescenta o relay real:
    RelaySnsPublisherJob (infrastructure/relay) publica as linhas
    pendentes do outbox no topico SNS FIFO score-calculado.fifo
    (MessageGroupId = pacienteId, AD-3).
  </description>

  <properties>
    <!-- Primeiro precedente de AWS SDK v2 runtime no reator (spec 3.0),
         verificado 2026-09-08 via Maven Central (nenhum outro modulo fixa
         essa versao ainda). -->
    <aws-sdk.version>2.54.14</aws-sdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws-sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Relay real do evento ScoreCalculado (Story 3.0, AD-3), publica no
         topico SNS FIFO. Credenciais/regiao resolvidas so via variavel de
         ambiente/role da task (DefaultCredentialsProvider), nunca
         hardcoded (Boundaries da spec 3.0). -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sns</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Bean Validation nao e usada nos DTOs desta story (a validacao vive
         no dominio: Cpf/SinaisVitais/GravidadePercebida), mas o starter e
         mantido para espelhar auth-service/pom.xml. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Boot 4.1 modularizou a autoconfiguracao (spring-boot-flyway),
         separada do starter de JPA. Sem isso o Flyway nunca roda: a
         migration so existe no classpath, mas o bean flywayInitializer
         nunca e criado, e o Hibernate valida um schema vazio (mesmo
         achado da Story 1.2, ver auth-service/pom.xml). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- payload/fatores contribuintes do Score em JSONB (eventos_outbox,
         triagens): serializado via Jackson (ja transitivo via
         spring-boot-starter-web), sem driver JSONB dedicado. -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Primeiro precedente de LocalStack no projeto (Ask First da spec
         3.0, decidido com o usuario em 2026-09-08): sobe SNS FIFO + fila
         SQS FIFO assinante + DLQ so para o teste de integracao do relay
         confirmar o envelope ponta a ponta, nunca toca a conta AWS real. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-localstack</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- SqsClient so no teste de integracao do relay (le a fila assinante
         de volta); producao so publica no SNS, nunca fala com SQS. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sqs</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>triagem-score-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- epic-2-context.md (Requirements & Constraints): cobertura de linha
           >=90% (JaCoCo) na camada de dominio. Regra restrita ao pacote
           domain via includes; application/infrastructure nao entram no
           limiar (ja cobertos por Testcontainers nos testes de integracao). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check-domain-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <includes>
                    <include>com.filajusta.triagem.domain.*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                  </limits>
                </rule>
                <!-- Boundaries da spec 3.0: cobertura >=90% de linha na
                     camada de "dominio/aplicacao do relay". RelaySnsPublisherJob
                     e a config do SnsClient vivem em infrastructure/relay
                     (Code Map da spec 3.0), nao em application/, entao o
                     bundle desta regra e esse pacote em vez de estender o
                     de cima. RelaySnsPublisherJobTest cobre via mock do
                     SnsClient (sem Testcontainers). -->
                <rule>
                  <element>BUNDLE</element>
                  <includes>
                    <include>com.filajusta.triagem.infrastructure.relay.*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Teste de mutacao (mesmo requisito do epic). Nao vinculado a
           nenhuma fase do lifecycle (custo alto); rodar sob demanda:
           mvn -pl triagem-score-service -am org.pitest:pitest-maven:mutationCoverage -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.30.0</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>1.2.2</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>com.filajusta.triagem.domain.*</param>
          </targetClasses>
          <targetTests>
            <param>com.filajusta.triagem.domain.*</param>
          </targetTests>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
