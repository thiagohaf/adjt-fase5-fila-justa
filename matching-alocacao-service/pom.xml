<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.filajusta</groupId>
    <artifactId>fila-justa-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>matching-alocacao-service</artifactId>
  <packaging>jar</packaging>

  <name>matching-alocacao-service</name>
  <description>
    Servico de dominio do FilaJusta (Epic 3). Story 3.1b entrega o esqueleto
    Clean Architecture (schema matching_alocacao) com o primeiro consumidor
    SQS real do projeto: ScoreCalculadoConsumerJob (infrastructure/relay)
    le a fila SQS FIFO assinante do topico SNS FIFO score-calculado.fifo
    (Story 3.0, triagem-score-service) e mantem uma replica local
    somente-leitura de Score via upsert idempotente (last-write-wins por
    occurredAt, desempate por eventId em ordem lexicografica). Story 3.1c
    expoe GET /v1/fila: recomputa a Prioridade Efetiva (Score + Aging com
    teto) sob demanda a partir da replica e ordena decrescente; replica
    vazia dispara um bootstrap sincrono a GET /internal/scores (Story 3.1a,
    triagem-score-service) antes de responder, reaproveitando o upsert
    idempotente da 3.1b.
  </description>

  <properties>
    <!-- Mesma versao do AWS SDK v2 ja fixada em triagem-score-service
         (Story 3.0) - reusa o precedente existente, nao introduz um novo. -->
    <aws-sdk.version>2.54.14</aws-sdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws-sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Primeiro consumidor SQS real do projeto (Story 3.1b, Design Notes):
         ScoreCalculadoConsumerJob le a fila SQS FIFO assinante de
         score-calculado.fifo. Credenciais/regiao resolvidas so via variavel
         de ambiente/role da task (DefaultCredentialsProvider), nunca
         hardcoded (mesmo Boundary da spec 3.0/RelaySnsClientConfig). -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sqs</artifactId>
    </dependency>
    <!-- Story 3-3a: infraestrutura outbox propria deste servico
         (RelaySnsPublisherJob), mesmo precedente ja usado em
         triagem-score-service/pom.xml (Story 3.0), mesma versao do BOM AWS
         SDK v2 ja fixada acima para o "sqs" do consumidor de
         ScoreCalculado. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sns</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Story 3.2b2: Bean Validation (NotBlank/Positive/NotNull) em
         UpsertRecursoRequest, mesmo precedente de auth-service/pom.xml
         (LoginRequest). Ainda nao usada em nenhum outro request deste
         servico (RegistrarTriagemRequest, triagem-score-service, delega a
         validacao ao dominio de proposito). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Boot 4.1 modularizou a autoconfiguracao de RestClient para fora de
         spring-boot-starter-web (mesmo achado ja documentado para o Flyway,
         ver comentario abaixo) - sem isso, RestClient.Builder nao tem
         nenhum bean autoconfigurado e o TriagemScoreClient (Story 3.1c,
         infrastructure/bootstrap) falha ao subir o contexto. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Boot 4.1 modularizou a autoconfiguracao do Flyway (mesmo achado da
         Story 1.2/2.1, ver triagem-score-service/pom.xml) - sem isso a
         migration so existe no classpath e o Hibernate valida um schema
         vazio. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Mesmo precedente de LocalStack da Story 3.0 - sobe uma fila SQS
         FIFO real so para o teste de integracao ponta a ponta do
         consumidor (envia a mensagem direto na fila, sem precisar
         reconstruir a assinatura SNS->SQS ja provada pela
         RelaySnsPublisherJobIntegrationTest do triagem-score-service);
         nunca toca a conta AWS real. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-localstack</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Primeiro precedente de WireMock no projeto (Story 3.1c, Design
         Notes): estuba GET /internal/scores (triagem-score-service, Story
         3.1a) para o teste de integracao do bootstrap a frio - papel
         analogo ao LocalStack para AWS na Story 3.0. Sem versao gerenciada
         pelas BOMs importadas (spring-boot-dependencies/spring-cloud-dependencies),
         por isso fixada explicitamente aqui. -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>3.10.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>matching-alocacao-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Boundaries da spec 3.1b: cobertura >=90% de linha (JaCoCo) no
           dominio/aplicacao. Dois bundles separados (mesmo padrao de
           triagem-score-service/pom.xml) - infrastructure NAO entra aqui;
           ScoreCalculadoConsumerJob e os adapters JPA sao cobertos pelos
           testes de integracao Testcontainers, nao pelo limiar de linha. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check-domain-application-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <includes>
                    <include>com.filajusta.matching.domain.*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>BUNDLE</element>
                  <includes>
                    <include>com.filajusta.matching.application.command.*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                  </limits>
                </rule>
                <!-- Story 3.1c: application.query entra no mesmo limiar de
                     application.command - Verification da spec 3.1c
                     ("JaCoCo >=90% dominio/aplicacao"). -->
                <rule>
                  <element>BUNDLE</element>
                  <includes>
                    <include>com.filajusta.matching.application.query.*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Teste de mutacao (mesmo requisito do epic, nao vinculado a
           nenhuma fase do lifecycle - roda sob demanda):
           mvn -pl matching-alocacao-service -am org.pitest:pitest-maven:mutationCoverage -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.30.0</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>1.2.2</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>com.filajusta.matching.domain.*</param>
          </targetClasses>
          <targetTests>
            <param>com.filajusta.matching.domain.*</param>
          </targetTests>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
