{
  "name": "confirmasus-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "type-check": "tsc --noEmit",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "e2e:run-fluxo": "cypress run --spec 'cypress/e2e/fluxo-completo.cy.ts'",
    "e2e:run-auditoria": "cypress run --spec 'cypress/e2e/auditoria-detalhes.cy.ts'"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.45.1",
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "cypress": "^16.1.0",
    "eslint": "^9.13.0",
    "globals": "^14.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.2",
    "vite": "^5.4.6"
  }
}
